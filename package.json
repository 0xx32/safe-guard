{
	"name": "turbo",
	"packageManager": "bun@1.2.9",
	"private": true,
	"scripts": {
		"prepare": "husky",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"devDependencies": {
		"@0x32/prettier": "^1.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.6",
		"prettier": "^3.6.2",
		"turbo": "^2.5.6",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=18"
	},
	"lint-staged": {
		"*.{js,ts}": "bun lint --fix",
		"*.{js,ts,json}": "bun prettier --write ."
	}
}
