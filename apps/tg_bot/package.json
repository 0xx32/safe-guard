{
	"name": "bot",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "bun run ./build.ts",
		"dev": "bun --watch src/index.ts",
		"start": "bun x drizzle-kit migrate && NODE_ENV=production bun src/index.ts",
		"lint": "bun x eslint",
		"lint:fix": "bun lint --fix",
		"format": "bun prettier . --write",
		"prepare": "husky"
	},
	"dependencies": {
		"@gramio/autoload": "^1.1.0",
		"@gramio/scenes": "^0.3.4",
		"@libsql/client": "^0.15.15",
		"@repo/db": "workspace:*",
		"@repo/node-eslint-config": "workspace:*",
		"@verrou/core": "^0.5.1",
		"axios": "^1.12.2",
		"drizzle-orm": "^0.44.5",
		"env-var": "^7.5.0",
		"gramio": "^0.4.10",
		"postgres": "^3.4.7"
	},
	"devDependencies": {
		"@0x32/prettier": "^1.0.0",
		"@antfu/eslint-config": "^5.2.2",
		"@types/bun": "^1.2.21",
		"esbuild-plugin-autoload": "^0.3.3",
		"eslint": "^9.35.0",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-perfectionist": "^4.15.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.6",
		"prettier": "^3.6.2",
		"typescript": "^5.9.2"
	},
	"lint-staged": {
		"*.{js,ts}": "bun lint --fix",
		"*.{js,ts,json}": "bun prettier --write"
	}
}